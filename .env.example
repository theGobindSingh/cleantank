# Copy to .env and fill in. Never commit .env.

# Public URL of the site, used for canonical, sitemap and social URLs.
SITE_URL=https://example.com

# Extra origin allowed to reach the dev server (e.g. a LAN IP or tunnel).
DEV_SERVER_ORIGIN=

# Payload. Generate a secret with: openssl rand -hex 32
PAYLOAD_SECRET=

# Neon Postgres. The direct URL is used by `pnpm payload` (migrations), the
# pooled one (host with -pooler) by the running site. Use a separate Neon
# branch for development so local work never touches production data.
# End both URLs with ?sslmode=verify-full (Neon gives sslmode=require, which
# the pg driver now warns about).
DATABASE_URL="postgresql://...?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://...?sslmode=verify-full"

# Neon S3-compatible storage for Payload uploads. Leave S3_BUCKET empty to keep
# uploads in the local /media folder instead.
AWS_ENDPOINT_URL_S3="https://<...>.storage.c-2.<...>.aws.neon.tech"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="..."
S3_BUCKET="uploads"
