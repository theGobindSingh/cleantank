{
  "name": "clean-tank-services",
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Gobind Singh",
    "email": "thesinghgobind@gmail.com",
    "url": "https://github.com/theGobindSingh/"
  },
  "private": true,
  "scripts": {
    "prepare": "husky && node scripts/link-agents.js",
    "prebuild": "pnpm run lint:fix",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm migrate && (pnpm logos:refresh || true) && pnpm build",
    "start": "next start",
    "payload": "PAYLOAD_DB_DIRECT=1 payload",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "logos:refresh": "pnpm payload run scripts/refresh-client-logos.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "lint": "prettier --config .prettierrc \"{src,e2e}/**/*.{ts,js,tsx,jsx}\" --check && eslint \"{src,e2e}/**/*.{ts,js,tsx,jsx}\"",
    "lint:fix": "prettier --config .prettierrc \"{src,e2e}/**/*.{ts,js,tsx,jsx}\" --write && eslint \"{src,e2e}/**/*.{ts,js,tsx,jsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "browser:install": "playwright-mcp install-browser chromium && playwright install chromium"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "@sentry/nextjs": "11.8.0",
    "graphql": "^16.14.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "payload": "^3.91.0",
    "posthog-js": "1.438.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@webadeva/eslint-config": "0.1.3",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "Website of Clean Tank Services, an initiative of Gobind Galaxy."
}
