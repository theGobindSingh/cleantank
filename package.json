{
  "name": "clean-tank",
  "version": "0.1.0",
  "author": {
    "name": "Gobind Singh",
    "email": "thesinghgobind@gmail.com",
    "url": "https://github.com/theGobindSingh/"
  },
  "private": true,
  "scripts": {
    "prebuild": "pnpm run gql:codegen",
    "dev": "next dev",
    "dev:all": "concurrently 'pnpm run dev' 'pnpm run gql:codegen:watch'",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --config .prettierrc \"src/**/*.{ts,js,tsx,jsx}\" --write && eslint \"src/**/*.{ts,js,tsx,jsx}\"",
    "lint:fix": "prettier --config .prettierrc \"src/**/*.{ts,js,tsx,jsx}\" --write && eslint \"src/**/*.{ts,js,tsx,jsx}\" --fix",
    "gql:codegen": "graphql-codegen --config ./src/codegen.ts",
    "gql:codegen:watch": "graphql-codegen --config ./src/codegen.ts --watch"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.1",
    "@contentful/rich-text-types": "^17.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@kami-ui/next-theme": "^0.0.22",
    "@kami-ui/react-components": "^0.0.3",
    "@kami-ui/theme-shop": "^0.0.2",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.100.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@webadeva/use-easy-google-form": "^3.0.2",
    "axios": "^1.16.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "lenis": "^1.3.21",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.15.4",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/schema-ast": "^5.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@kami-ui/eslint-config": "^0.0.6",
    "@kami-ui/types": "^0.0.3",
    "@parcel/watcher": "^2.5.6",
    "@tanstack/eslint-plugin-query": "^5.100.5",
    "@tanstack/react-devtools": "^0.10.1",
    "@tanstack/react-form-devtools": "^0.2.20",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "glob": "^13.0.0",
    "globals": "^17.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "rimraf": "^6.1.2",
    "glob": "^13.0.0"
  },
  "resolutions": {
    "rimraf": "^6.1.2",
    "glob": "^13.0.0"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
